# Central configuration. All scripts source this file.
# Edit values here (or export them in your shell before running a script to override).

# Model(s) to pull. Space-separated list; the first one is the default for tests/client.
# Browse options at https://ollama.com/library
OLLAMA_MODELS_TO_PULL="${OLLAMA_MODELS_TO_PULL:-llama3.1:8b}"

# Where the server listens. Keep 127.0.0.1 unless other machines must reach it.
OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:11434}"

# Where model weights are stored (they are large: ~5 GB for an 8B model).
# Point this at a disk with enough free space.
OLLAMA_MODELS="${OLLAMA_MODELS:-$HOME/.ollama/models}"

# Where the ollama binary is installed when no sudo is available.
OLLAMA_INSTALL_DIR="${OLLAMA_INSTALL_DIR:-$HOME/.local/ollama}"

# How long a model stays loaded in memory after the last request.
OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:-30m}"

# Runtime files (logs, pid) — kept inside the repo, git-ignored.
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN_DIR="${RUN_DIR:-$REPO_DIR/run}"

export OLLAMA_HOST OLLAMA_MODELS OLLAMA_KEEP_ALIVE OLLAMA_MODELS_TO_PULL
# Make a user-local install visible on PATH.
export PATH="$OLLAMA_INSTALL_DIR/bin:$PATH"
